# Copy to .env and fill in real values. Never commit .env.

# ---- Google Cloud ----
# Project id, from console.cloud.google.com project selector (top bar).
# Used for Cloud Run deploys, Firestore, and Agent Builder.
GCP_PROJECT_ID=broadcast-ops-copilot

# Region for Cloud Run services and Agent Builder. Not looked up anywhere —
# just pick one. us-central1 is the safe default (broadest Vertex AI /
# Agent Builder + Cloud Run availability); only change it if you have a
# reason to (e.g. latency to a specific audience).
GCP_REGION=us-central1

# Usually leave this EMPTY. Run `gcloud auth application-default login`
# once instead — it logs you in via browser and Google client libraries
# pick up the credentials automatically, no file needed.
# Only set this to a path if you specifically need to impersonate a
# service account locally: GCP Console > IAM & Admin > Service Accounts >
# [account] > Keys > Add Key > Create new key (JSON), then point here.
# Not needed at all on Cloud Run — it uses its attached runtime service
# account instead.
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Gemini through Vertex AI ----
# The agents use Vertex AI with Application Default Credentials; they do not
# read a Google AI Studio API key. Authenticate with:
#   gcloud auth application-default login
# and set GCP_PROJECT_ID/GCP_REGION above.
# Application deadline shared by Gemini generation and Vertex embedding calls.
# A timed-out request is attempted once more, then the incident fails safely.
EXTERNAL_AI_TIMEOUT_SECONDS=45

# ---- Grafana Cloud ----
# Base URL of your Grafana Cloud stack, from grafana.com > My Account >
# your stack's details page. Used for the annotations HTTP API.
GRAFANA_CLOUD_URL=https://niftykangaroo3569.grafana.net

# Service account token, from Grafana Cloud > Administration > Service
# accounts. Needs both annotations:write (for the annotations API) and
# metrics:write (this same token is reused as the Basic Auth password for
# the Prometheus remote_write push below).
GRAFANA_CLOUD_API_KEY=REPLACE_ME_ROTATED

# Prometheus remote_write push endpoint for mock-pipeline's live metrics.
# This is DIFFERENT from GRAFANA_CLOUD_URL above — find it at Grafana Cloud
# portal > your stack > Prometheus (or "Hosted Metrics") > Details > "Remote
# Write Endpoint". Looks like:
# https://prometheus-prod-NN-prod-<region>.grafana.net/api/prom/push
GRAFANA_PROMETHEUS_PUSH_URL=

# The numeric "Username / Instance ID" shown on that same Prometheus
# details page (Basic Auth username; GRAFANA_CLOUD_API_KEY is the password).
GRAFANA_PROMETHEUS_USERNAME=

# ---- Infra Agent: read telemetry through the local Grafana MCP server ----
# Local Grafana (docker-compose). Create a Viewer service account + token:
#   POST /api/serviceaccounts {"name":"mcp-grafana","role":"Viewer"}
#   POST /api/serviceaccounts/<id>/tokens {"name":"mcp-grafana-token","secondsToLive":0}
GRAFANA_URL=http://localhost:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_REPLACE_ME
# UID of the local Prometheus data source in Grafana (Connections > Data sources).
GRAFANA_DATASOURCE_UID=mediaops-prometheus
# grafana_mcp  -> query telemetry through `uvx mcp-grafana` (Grafana in the loop)
# prometheus_http -> deterministic direct Prometheus HTTP fallback (no MCP needed)
INFRA_METRICS_SOURCE=grafana_mcp
# INFRA_MODEL=gemini-2.5-flash
# PROMETHEUS_URL=http://localhost:9090

# ---- Remediation Agent (Step 9) ----
# Gemini model that proposes ONE action from the fixed enum. Advice only.
# REMEDIATION_MODEL=gemini-2.5-flash

# ---- Knowledge Base + RAG (Step 8) ----
# EMBED_MODEL=text-embedding-005
# FIRESTORE_KB_COLLECTION=knowledge_base
# KB_RELEVANCE_THRESHOLD=0.80   # cosine floor; below this = discarded, no weak matches
# KB_MAX_MATCHES=3

# ---- Slack ----
# Incoming webhook URL for the ops channel, from Slack >
# api.slack.com/apps > your app > Incoming Webhooks.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE_ME_ROTATED

# ---- Firestore ----
# Firestore database id. Usually "(default)" unless a named database was
# created in the Firestore console for this project.
FIRESTORE_DATABASE_ID=(default)

# ---- Service URLs ----
# Populated after each service's first Cloud Run deploy (gcloud run deploy
# prints the URL). Used so services can call each other.
ORCHESTRATOR_URL=
DETECTOR_URL=
DIAGNOSER_URL=
REMEDIATOR_URL=
MOCK_PIPELINE_URL=

# ---- harness ----
# Local path to the reference video used by harness/ ffmpeg scripts to
# generate failure-variant clips for demo scenarios.
REFERENCE_VIDEO_PATH=
