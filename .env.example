# Copy to .env and fill in real values. Never commit .env.

# ---- Google Cloud ----
# Project id, from console.cloud.google.com project selector (top bar).
# Used for Cloud Run deploys, Firestore, and Agent Builder.
GCP_PROJECT_ID=broadcast-ops-copilot

# Region for Cloud Run services and Agent Builder. Not looked up anywhere —
# just pick one. us-central1 is the safe default (broadest Vertex AI /
# Agent Builder + Cloud Run availability); only change it if you have a
# reason to (e.g. latency to a specific audience).
GCP_REGION=us-central1

# Usually leave this EMPTY. Run `gcloud auth application-default login`
# once instead — it logs you in via browser and Google client libraries
# pick up the credentials automatically, no file needed.
# Only set this to a path if you specifically need to impersonate a
# service account locally: GCP Console > IAM & Admin > Service Accounts >
# [account] > Keys > Add Key > Create new key (JSON), then point here.
# Not needed at all on Cloud Run — it uses its attached runtime service
# account instead.
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Gemini ----
# From Google AI Studio (aistudio.google.com) > Get API key. If calling
# Gemini through Vertex AI instead, this can be left unset and
# GOOGLE_APPLICATION_CREDENTIALS + GCP_PROJECT_ID are used instead.
GEMINI_API_KEY=REPLACE_ME_ROTATED

# ---- Grafana Cloud ----
# Base URL of your Grafana Cloud stack, from grafana.com > My Account >
# your stack's details page.
GRAFANA_CLOUD_URL=https://niftykangaroo3569.grafana.net

# Service account token with read+write access (metrics query + alert
# rules), from Grafana Cloud > Administration > Service accounts.
GRAFANA_CLOUD_API_KEY=REPLACE_ME_ROTATED

# ---- Slack ----
# Incoming webhook URL for the ops channel, from Slack >
# api.slack.com/apps > your app > Incoming Webhooks.
SLACK_INCOMING_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE_ME_ROTATED

# ---- Firestore ----
# Firestore database id. Usually "(default)" unless a named database was
# created in the Firestore console for this project.
FIRESTORE_DATABASE_ID=(default)

# ---- Service URLs ----
# Populated after each service's first Cloud Run deploy (gcloud run deploy
# prints the URL). Used so services can call each other.
ORCHESTRATOR_URL=
DETECTOR_URL=
DIAGNOSER_URL=
REMEDIATOR_URL=
MOCK_PIPELINE_URL=

# ---- harness ----
# Local path to the reference video used by harness/ ffmpeg scripts to
# generate failure-variant clips for demo scenarios.
REFERENCE_VIDEO_PATH=
